 "categories": [
  {
   "name": "Programming code syntax and identifiers",
   "definition": "Features that fire on tokens of general-purpose programming or shell code, such as keywords, operators used in code control flow, import/package paths, library, class, function and type names, and code-comment or docstring structure, excluding HTML/CSS markup and web URLs."
  },
  {
   "name": "Web markup, styling and URLs",
   "definition": "Features that fire on HTML/XML/SVG tags and attributes, CSS properties and values, DOM/web-page boilerplate code, or components of URLs, domains and web addresses."
  },
  {
   "name": "Mathematical notation and quantitative problems",
   "definition": "Features that fire on math expressions or math/quantitative word-problem language, including operators, operands, exponents, variables, coefficients, fractions, negative signs, and math-task vocabulary such as 'divided by', 'nearest integer', 'derivative' or 'Find'."
  },
  {
   "name": "Repetition and sequence patterns",
   "definition": "Features whose main trigger is position within a repetitive, periodic or enumerated sequence, such as number lists, repeated tokens or copied fragments, where the token is predictable from an established pattern rather than from its meaning."
  },
  {
   "name": "Citations, references and bibliographic metadata",
   "definition": "Features that fire on parts of academic, legal or patent references and document metadata, such as citation numbers and brackets, author-year separators, et al., DOIs, journal names, page and volume numbers, figure/section cross-references, dates in references, and tables of contents."
  },
  {
   "name": "Legal, license and website boilerplate",
   "definition": "Features that fire on formulaic boilerplate text, including software and content license wording, copyright and warranty disclaimers, terms-of-use phrasing, and recurring website interface or navigation labels such as 'Posts', 'Reply' or 'Advertisement'."
  },
  {
   "name": "Scientific and biomedical terminology",
   "definition": "Features that fire on technical vocabulary or word pieces from biology, medicine, chemistry, physics or materials science, such as disease, anatomy, gene, protein, species and physical-effect terms."
  },
  {
   "name": "Named entities",
   "definition": "Features that fire on proper names of specific people, places, organizations, companies, political groups or brands, including subword pieces that spell those names."
  },
  {
   "name": "General-domain concepts in prose",
   "definition": "Features that fire on topical or semantic word meanings in ordinary prose outside science, code, math and boilerplate, such as sports, politics, crime, law, media, history, everyday life, or particular grammatical and discourse functions of words."
  },
  {
   "name": "Document structure and formatting boundaries",
   "definition": "Features that fire on structural tokens marking boundaries or roles in text layout, such as newlines ending paragraphs or fields, headings, list markers, separators, metadata labels, Q&A, quiz and answer prompts, multiple-choice options, and assistant-response formatting."
  },
  {
   "name": "Diffuse or unclear",
   "definition": "Features whose descriptions call their activation diffuse, weak, nonspecific, noise-like, or tied to garbled text with no clear lexical or semantic theme."
  }
 ],
